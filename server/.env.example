# 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채우세요.
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
#
# Turso 대시보드 또는 CLI에서 얻는 값입니다.
#   turso db show <DB이름> --url
#   turso db tokens create <DB이름>
#
# 두 값을 비워두면 로컬 SQLite 파일(server/data/advices.db)을 사용합니다.

TURSO_DATABASE_URL=libsql://your-db-name-your-account.turso.io
TURSO_AUTH_TOKEN=여기에_토큰_붙여넣기

# DB 엔진에 맞는 드라이버를 고릅니다. 비워두면 libsql 입니다.
#   libsql = 기존 libSQL 엔진 (대시보드에서 libSQL 선택)
#   turso  = 신규 Turso 엔진 (대시보드에서 Turso 선택)
# 연결이 안 되면 반대쪽 값으로 바꿔보세요.
# TURSO_DRIVER=libsql
